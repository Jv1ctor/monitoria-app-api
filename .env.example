PORT_API = [you-port-number]
FRONTEND_URL = [client-port]

DATABASE_URL="postgresql://[user]:[password]@localhost:[port_public]/[db_name]?schema=public"
DB_USER=[your_user_db]
DB_NAME=[your_name_db]
DB_PASS=[your_password_db]

DB_PORT_PUBLIC=[your_port_public_db]


JWT_KEY=[your_key]
JWT_EXPIRES=[expires_time]


ADMIN_REGISTRATION=0000000
ADMIN_PASSWORD=[password_admin]
ADMIN_EMAIL=admin@example.com


S3_REGION=[region_s3]
S3_BUCKET=[your_bucket]
S3_ENDPOINT=[endpoint_s3]
S3_UPLOAD_URL_EXPIRES_IN=[seconds_expires]
S3_DOWNLOAD_URL_EXPIRES_IN=[seconds_expires]
S3_PREVIEW_URL_EXPIRES_IN=[seconds_expires]